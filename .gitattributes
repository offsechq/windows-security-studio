images export-ignore
# Cross-platform baseline: store and check out text files as LF.
* text=auto eol=lf

# Keep Windows batch scripts with CRLF for maximum compatibility.
*.cmd text eol=crlf
*.bat text eol=crlf

# Prevent README and Wiki posts from syncing with upstream
README.md merge=ours
"Wiki posts/**" merge=ours

# Prevent OFFSECHQ customizations from being overwritten by upstream
LICENSE merge=ours
.gitattributes merge=ours

# Protect the WSS application tree from upstream path churn.
"Windows Security Studio/**" merge=ours

# Protect custom workflows
".github/workflows/sync-upstream.yml" merge=ours
".github/workflows/Build Windows Security Studio MSIX Package.yml" merge=ours
